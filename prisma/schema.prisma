// Prisma Schema for VENM Catalog

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         String    @default("CUSTOMER")
  inquiries    Inquiry[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Collection {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  tagline      String?
  description  String?
  coverImage   String
  season       String?
  status       String    @default("ACTIVE") // ACTIVE | COMING_SOON
  featured     Boolean   @default(false)
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  status       String    @default("Active")
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id                String      @id @default(uuid())
  name              String
  slug              String      @unique
  description       String?
  details           String      @default("[]") // JSON string of spec bullets
  collectionId      String?
  collection        Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  categoryId        String?
  categoryObj       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collectionSlug    String?
  collectionName    String?
  category          String?
  images            String      @default("[]") // JSON string array of image URLs
  sizes             String      @default("[]") // JSON string array of size tags
  availability      String      @default("REQUESTABLE") // REQUESTABLE | PUBLISHED | PAUSED | COMING_SOON | DRAFT
  estimatedPrice    String?     @default("Estimated from ₹1,800")
  minPrice          String?
  maxPrice          String?
  priceDisplayMode  String?     @default("STARTING_FROM") // STARTING_FROM | PRICE_RANGE | CUSTOM_QUOTE
  customizationInfo String?     @default("Custom embroidery, fit adjustments, and design alterations available.")
  sizingInfo        String?     @default("Custom sizing available according to your requirements.")
  sourceAttribution String?     @default("VENM Reference Design")
  isFeatured        Boolean     @default(false)
  isNavratriEdit    Boolean     @default(false)
  tags              String      @default("[]") // JSON string array
  garmentCare       String?
  gender            String?     @default("UNCLASSIFIED") // MEN | WOMEN | UNISEX | UNCLASSIFIED
  viewCount         Int         @default(0)
  displayOrder      Int         @default(0)
  inquiries         Inquiry[]
  costingProfiles   ProductCosting[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([collectionId])
  @@index([categoryId])
  @@index([collectionSlug])
  @@index([availability])
  @@index([isFeatured, displayOrder])
  @@index([gender])
}

model Campaign {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  image          String?
  announcement   String?
  startDate      String?
  endDate        String?
  status         String   @default("ACTIVE") // ACTIVE | SCHEDULED | ENDED
  theme          String?  @default("Festive")
  festivalLights Boolean  @default(true)
  dandiya        Boolean  @default(true)
  chunri         Boolean  @default(true)
  bangles        Boolean  @default(false)
  festivalGlow   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomepageSection {
  id           String   @id @default(uuid())
  sectionKey   String   @unique // hero | featured_collection | featured_products | brand_statement | lookbook | final_cta
  name         String
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  content      String   @default("{}") // JSON string of content fields
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String?  @default("image/webp")
  size      String?
  category  String?  @default("Products")
  usedBy    String?  @default("Catalog")
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id         String   @id @default(uuid())
  sectionKey String   @unique // general | whatsapp | social | seo
  data       String   @default("{}") // JSON string of settings
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid())
  adminUserId String?
  adminEmail  String?
  action      String
  entityType  String
  entityId    String?
  entityName  String?
  description String?
  metadata    String?  @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([entityType])
}

model Inquiry {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientName     String?
  clientContact  String?
  clientEmail    String?
  clientPhone    String?
  userMeta       String?  @default("{}")
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug    String?
  productName    String
  productImage   String?
  productPrice   String?
  collectionName String?
  selectedSize   String?
  requestType    String?  @default("I have my garment")
  note           String?
  status         String   @default("SUBMITTED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([clientContact])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model EmailSubscriber {
  id                String    @id @default(uuid())
  email             String    @unique
  marketingConsent  Boolean   @default(false)
  consentTimestamp  DateTime?
  consentSource     String    @default("POPUP") // POPUP | FOOTER | MODAL | ADMIN
  consentWording    String?
  consentVersion    String    @default("1.0")
  status            String    @default("SUBSCRIBED") // SUBSCRIBED | UNSUBSCRIBED | SUPPRESSED
  unsubscribeToken  String    @unique @default(uuid())
  unsubscribedAt    DateTime?
  unsubscribeReason String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt(sort: Desc)])
}

model EmailCampaign {
  id             String    @id @default(uuid())
  title          String
  subject        String
  previewText    String?
  campaignType   String    // COLLECTION_ANNOUNCEMENT | PRODUCT_DROP | CUSTOM_SERVICES | SPECIAL_OFFER | BRAND_ANNOUNCEMENT
  contentHtml    String
  contentText    String?
  status         String    @default("DRAFT") // DRAFT | REVIEWED | APPROVED | SENDING | SENT | CANCELLED
  approvedBy     String?
  approvedAt     DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  metadata       String?   @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([campaignType])
  @@index([createdAt(sort: Desc)])
}

model Invoice {
  id                  String        @id @default(uuid())
  invoiceNumber       String        @unique
  invoiceDate         DateTime      @default(now())
  dueDate             DateTime?
  invoiceType         String        @default("TAX_INVOICE") // TAX_INVOICE | PROFORMA | COMMERCIAL | RECEIPT
  status              String        @default("DRAFT") // DRAFT | ISSUED | PAID | CANCELLED
  paymentStatus       String        @default("UNPAID") // UNPAID | PARTIALLY_PAID | PAID
  paymentMethod       String?       @default("UPI") // UPI | BANK_TRANSFER | CASH | CARD | CHEQUE | OTHER
  preparedBy          String?       // admin name or email
  orderId             String?       // optional linked order / inquiry ID
  orderDate           DateTime?

  // Brand Details Snapshot
  brandName           String        @default("VENM")
  brandTagline        String?       @default("Tradition with a Bite")
  brandLogo           String?
  brandEmail          String?       @default("venm1310@gmail.com")
  brandPhone          String?       @default("+91 74340 96095")
  brandGstin          String?       @default("24AAAAA0000A1Z5")
  brandAddress        String?       @default("Ahmedabad, Gujarat, India")

  // Customer Details Snapshot
  customerName        String
  customerPhone       String?
  customerEmail       String?
  billingAddress      String?
  shippingAddress     String?
  city                String?
  state               String?       @default("Gujarat")
  pincode             String?
  customerGstin       String?

  // Tax & Pricing Mode
  taxEnabled          Boolean       @default(true)
  taxType             String        @default("INTRA_STATE") // INTRA_STATE (CGST+SGST) | INTER_STATE (IGST)
  pricingMode         String        @default("TAX_EXCLUSIVE") // TAX_EXCLUSIVE | TAX_INCLUSIVE

  // Financial Calculations
  subtotal            Float         @default(0)
  itemDiscountTotal   Float         @default(0)
  invoiceDiscountType String        @default("FIXED") // FIXED | PERCENTAGE
  invoiceDiscountValue Float        @default(0)
  invoiceDiscountTotal Float        @default(0)
  totalDiscount       Float         @default(0)
  taxableAmount       Float         @default(0)
  cgstAmount          Float         @default(0)
  sgstAmount          Float         @default(0)
  igstAmount          Float         @default(0)
  totalTax            Float         @default(0)
  shippingCharges     Float         @default(0)
  packagingCharges    Float         @default(0)
  additionalCharges   Float         @default(0)
  roundOff            Float         @default(0)
  grandTotal          Float         @default(0)
  amountPaid          Float         @default(0)
  advancePaid         Float         @default(0)
  balanceDue          Float         @default(0)
  paymentDate         DateTime?
  transactionRef      String?

  // Notes & Additional Fields
  customerNotes       String?
  customizationNotes  String?
  deliveryNotes       String?
  paymentTerms        String?
  termsAndConditions  String?
  thankYouMessage     String?       @default("Thank you for choosing VENM.")
  internalNotes       String?

  // Display Visibility Toggles
  showBrandLogo       Boolean       @default(true)
  showBrandGstin      Boolean       @default(true)
  showShippingAddress Boolean       @default(true)
  showItemImages      Boolean       @default(false)
  showItemHsn         Boolean       @default(true)
  showItemDiscount    Boolean       @default(true)
  showItemDescription Boolean       @default(true)
  showCustomerNotes   Boolean       @default(true)
  showPaymentDetails  Boolean       @default(true)
  showTerms           Boolean       @default(true)

  items               InvoiceItem[]
  orderCosting        OrderCosting?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([invoiceNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerName])
  @@index([invoiceDate(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?  // Reference to catalog product (snapshot only, never mutates catalog)
  name            String
  sku             String?
  image           String?
  size            String?
  color           String?
  description     String?
  hsnCode         String?  @default("6203")
  quantity        Int      @default(1)
  unitPrice       Float    @default(0)
  discountType    String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  discountValue   Float    @default(0)
  discountAmount  Float    @default(0)
  taxRate         Float    @default(12)
  taxableAmount   Float    @default(0)
  taxAmount       Float    @default(0)
  lineTotal       Float    @default(0)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

model InvoiceSetting {
  id                  String   @id @default(uuid())
  brandName           String   @default("VENM")
  brandTagline        String?  @default("Tradition with a Bite")
  brandLogo           String?
  brandEmail          String?  @default("venm1310@gmail.com")
  brandPhone          String?  @default("+91 74340 96095")
  brandGstin          String?  @default("24AAAAA0000A1Z5")
  brandAddress        String?  @default("Ahmedabad, Gujarat, India")
  invoicePrefix       String   @default("VNM-INV")
  defaultTaxRate      Float    @default(12)
  defaultTaxEnabled   Boolean  @default(true)
  defaultTaxType      String   @default("INTRA_STATE") // INTRA_STATE | INTER_STATE
  defaultPricingMode  String   @default("TAX_EXCLUSIVE")
  defaultPaymentTerms String?  @default("Full payment due within 7 days of invoice date.")
  defaultTerms        String?  @default("1. Goods once customized or sold cannot be returned without prior authorization.\n2. All bespoke tailoring alterations must be claimed within 15 days of delivery.\n3. Subject to Ahmedabad jurisdiction.")
  defaultThankYou     String?  @default("Thank you for choosing VENM. Tradition with a Bite.")
  updatedAt           DateTime @updatedAt
}

model CostCategory {
  id           String                 @id @default(uuid())
  name         String
  slug         String                 @unique
  description  String?
  costType     String                 @default("DIRECT_COGS") // DIRECT_COGS | PACKAGING_SHIPPING | MARKETING | OPERATING
  isDefault    Boolean                @default(false)
  isActive     Boolean                @default(true)
  displayOrder Int                    @default(0)
  components   ProductCostComponent[]
  expenses     Expense[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([slug])
  @@index([costType])
}

model ProductCosting {
  id                    String                 @id @default(uuid())
  productId             String?
  product               Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName           String
  sku                   String?
  category              String?
  collection            String?
  productType           String                 @default("READY_TO_WEAR") // READY_TO_WEAR | BESPOKE | PROMOTIONAL_GIFT | CUSTOM_ORDER
  size                  String?
  color                 String?
  batchQuantity         Int                    @default(1)
  targetMargin          Float                  @default(65.0) // %
  estimatedUnitCost     Float                  @default(0)
  actualUnitCost        Float                  @default(0)
  estimatedSellingPrice Float                  @default(0)
  actualSellingPrice    Float                  @default(0)
  suggestedSellingPrice Float                  @default(0)
  grossProfit           Float                  @default(0)
  grossProfitMargin     Float                  @default(0)
  markupPercentage      Float                  @default(0)
  status                String                 @default("COMPLETED") // DRAFT | ESTIMATED | COMPLETED | ARCHIVED
  notes                 String?
  components            ProductCostComponent[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([status])
}

model ProductCostComponent {
  id               String         @id @default(uuid())
  productCostingId String
  productCosting   ProductCosting @relation(fields: [productCostingId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         CostCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName     String
  description      String
  quantity         Float          @default(1)
  unit             String?        @default("pcs")
  unitCost         Float          @default(0)
  totalCost        Float          @default(0)
  costType         String         @default("ACTUAL") // ESTIMATED | ACTUAL
  supplier         String?
  expenseDate      DateTime?
  paymentStatus    String?        @default("PAID")
  receiptUrl       String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([productCostingId])
  @@index([categoryId])
}

model OrderCosting {
  id                 String                   @id @default(uuid())
  invoiceId          String                   @unique
  invoice            Invoice                  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId            String?
  status             String                   @default("COMPLETED") // PENDING | IN_PROGRESS | COMPLETED | REVIEWED
  allocationMethod   String                   @default("BY_REVENUE") // EQUAL | BY_QUANTITY | BY_REVENUE | MANUAL
  totalDirectCost    Float                    @default(0) // Sum of line item COGS
  totalAllocatedCost Float                    @default(0) // Shared packaging, actual shipping, delivery, gifts, payment fees
  totalOrderCost     Float                    @default(0) // totalDirectCost + totalAllocatedCost
  netRevenue         Float                    @default(0) // Invoice taxable amount (revenue excluding sales tax)
  grossProfit        Float                    @default(0) // netRevenue - totalDirectCost
  grossProfitMargin  Float                    @default(0) // (grossProfit / netRevenue) * 100
  netProfit          Float                    @default(0) // grossProfit - totalAllocatedCost
  netProfitMargin    Float                    @default(0) // (netProfit / netRevenue) * 100
  notes              String?
  items              OrderItemCosting[]
  expenses           OrderExpenseAllocation[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([invoiceId])
  @@index([orderId])
  @@index([status])
}

model OrderItemCosting {
  id                String       @id @default(uuid())
  orderCostingId    String
  orderCosting      OrderCosting @relation(fields: [orderCostingId], references: [id], onDelete: Cascade)
  invoiceItemId     String?
  productId         String?
  name              String
  sku               String?
  size              String?
  color             String?
  quantity          Int          @default(1)
  sellingPrice      Float        @default(0)
  discountAmount    Float        @default(0)
  netItemRevenue    Float        @default(0)
  isPromotionalGift Boolean      @default(false)
  unitCost          Float        @default(0)
  totalCost         Float        @default(0) // quantity * unitCost
  allocatedExpense  Float        @default(0)
  grossProfit       Float        @default(0)
  grossProfitMargin Float        @default(0)
  costComponents    String?      @default("[]") // JSON string of component details
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([orderCostingId])
  @@index([invoiceItemId])
  @@index([productId])
}

model OrderExpenseAllocation {
  id               String       @id @default(uuid())
  orderCostingId   String
  orderCosting     OrderCosting @relation(fields: [orderCostingId], references: [id], onDelete: Cascade)
  expenseId        String?
  categoryName     String
  description      String
  amount           Float        @default(0)
  allocationMethod String       @default("BY_REVENUE")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderCostingId])
  @@index([expenseId])
}

model Expense {
  id                       String        @id @default(uuid())
  expenseNumber            String        @unique // e.g. VNM-EXP-2026-0001
  expenseDate              DateTime      @default(now())
  categoryId               String?
  category                 CostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName             String
  description              String
  expenseType              String        @default("OPERATING") // DIRECT_COGS | ORDER_VARIABLE | OPERATING | MARKETING | CAPITAL
  amountBeforeTax          Float         @default(0)
  taxRate                  Float         @default(0)
  taxAmount                Float         @default(0)
  totalAmount              Float         @default(0) // amountBeforeTax + taxAmount
  isInputTaxCreditEligible Boolean       @default(false)
  currency                 String        @default("INR")
  supplier                 String?
  paymentStatus            String        @default("PAID") // UNPAID | PARTIALLY_PAID | PAID
  paymentMethod            String?       @default("UPI") // UPI | BANK_TRANSFER | CASH | CARD | OTHER
  paymentDate              DateTime?
  invoiceId                String?       // optional link to invoice / order
  productId                String?       // optional link to product
  receiptUrl               String?
  notes                    String?
  isAllocatedToOrder       Boolean       @default(false) // Prevents double counting in reports
  isArchived               Boolean       @default(false)
  createdBy                String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([expenseNumber])
  @@index([expenseDate(sort: Desc)])
  @@index([categoryId])
  @@index([expenseType])
  @@index([paymentStatus])
}

model CostingSetting {
  id                      String   @id @default(uuid())
  defaultTargetMargin     Float    @default(65.0) // %
  currency                String   @default("INR")
  defaultPackagingCost    Float    @default(50.0)
  defaultShippingCost     Float    @default(150.0)
  defaultGiftCost         Float    @default(200.0)
  defaultAllocationMethod String   @default("BY_REVENUE") // EQUAL | BY_QUANTITY | BY_REVENUE | MANUAL
  taxPreference           String   @default("TAX_EXCLUSIVE")
  lowMarginThreshold      Float    @default(30.0)
  criticalMarginThreshold Float    @default(15.0)
  updatedAt               DateTime @updatedAt
}
