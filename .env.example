PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/venmdb?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Cloudinary Persistent Image Storage Configuration
# Cloudinary API Secret is strictly backend-only (never exposed to frontend code)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="venm-catalog/products"
